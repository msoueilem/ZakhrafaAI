# ZakhrafaAI — variables d'environnement (copier en .env, jamais commité).
# docker compose lit .env automatiquement pour l'interpolation ${VAR}.

# Clé API Google Gemini (https://aistudio.google.com/apikey).
# Vide => le mode « Rendu IA » se replie sur le générateur procédural.
GEMINI_API_KEY=

# Modèle d'image Gemini : gemini-3.1-flash-image (défaut, ~0,067 $/image 1K),
# gemini-3.1-flash-lite-image (~0,034 $, mais rendu du zellige trop plat)
# ou gemini-3-pro-image (plus cher).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Rendus IA réussis max par jour UTC (30 ≈ 2 $/jour avec le modèle par défaut).
GEMINI_DAILY_LIMIT=30

# Tentatives de rendu IA max par adresse IP sur 10 minutes.
GEMINI_PER_IP_LIMIT=5

# Délai max d'un appel Gemini, en secondes.
GEMINI_TIMEOUT=90

# Clé API DeepSeek (https://platform.deepseek.com/api_keys) pour l'assistant
# de prompt (/api/assist). Vide => endpoints en 503 {"code":"assist_disabled"}.
DEEPSEEK_API_KEY=

# Modèle DeepSeek : deepseek-flash (défaut, le moins cher) ou deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

# Appels DeepSeek facturés max par jour UTC (500 ≈ 0,10 à 0,35 $/jour).
DEEPSEEK_DAILY_LIMIT=500

# Requêtes d'assistant max par adresse IP sur 10 minutes.
DEEPSEEK_PER_IP_LIMIT=20

# Délai max d'un appel DeepSeek, en secondes.
DEEPSEEK_TIMEOUT=20

# Port publié sur 127.0.0.1 par docker compose.
ZAKHRAFAAI_PORT=8000

# Dossier des compteurs journaliers (/data dans l'image Docker,
# backend/data en lancement local si non défini).
# ZAKHRAFAAI_DATA_DIR=
